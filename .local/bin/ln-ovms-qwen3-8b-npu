#!/usr/bin/bash
set -euo pipefail

MODEL_DIR="/home/ln/.local/share/ovms-qwen3-npu"
CONTAINER="qwen3-npu"
IMAGE="openvino/model_server:latest-gpu"

# Validate required files and devices before starting.
test -r "$MODEL_DIR/config.json"
test -e /dev/accel
test -e /dev/dri/renderD128

USER_UID="$(id -u ln)"
USER_GID="$(id -g ln)"
RENDER_GID="$(stat -c '%g' /dev/dri/renderD128)"

exec /usr/bin/docker run \
  --rm \
  --name "$CONTAINER" \
  --device /dev/accel \
  --group-add "$RENDER_GID" \
  --user "$USER_UID:$USER_GID" \
  -p 127.0.0.1:8000:8000 \
  -v "$MODEL_DIR:/models:rw" \
  "$IMAGE" \
  --rest_port 8000 \
  --config_path /models/config.json