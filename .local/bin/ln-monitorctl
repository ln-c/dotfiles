#!/usr/bin/env bash

LAPTOP_MONITOR=eDP-1

# One hyprctl query; the monitor list (and so its count) is derived from it.
if ! MONITOR_INFO=$(hyprctl monitors all); then
    echo "Error: hyprctl monitors all failed (is Hyprland running?)" >&2
    exit 1
fi
MONITORS=$(awk '/^Monitor/ {print $2}' <<<"$MONITOR_INFO")

# Check if a monitor name was provided
if [[ -z "$1" ]]; then
    {
        echo "Usage: ln-monitorctl <monitor_name> [on|off]"
        echo ""
        echo "Available monitors:"
        echo "$MONITORS"
    } >&2
    exit 1
fi

# "ini" disables the laptop panel, but only when another monitor is connected
if [[ "$1" == "ini" ]]; then
    if (( $(wc -l <<<"$MONITORS") > 1 )); then
        hyprctl eval "hl.monitor({ output = \"$LAPTOP_MONITOR\", disabled = true })"
    fi
    exit 0
fi

# Check whether a valid monitor is provided
if ! grep -Fxq -- "$1" <<<"$MONITORS"; then
    echo "Error: Invalid monitor ID" >&2
    echo "Try ln-monitorctl without argument to see the list of monitor IDs" >&2
    exit 1
fi
MONITOR="$1"

# Default to 'off' if the second argument isn't provided
case "${2:-off}" in
    off) disabled=true verb=Disabling ;;
    on) disabled=false verb=Enabling ;;
    *)
        echo "Error: Action must be 'on' or 'off'." >&2
        exit 1
        ;;
esac

echo "$verb $MONITOR"
hyprctl eval "hl.monitor({ output = \"$MONITOR\", disabled = $disabled })"
